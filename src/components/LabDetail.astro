---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoPanel from './DemoPanel.astro';
import { getLabPage } from '../lib/lab-pages';
import { getUi } from '../i18n/dictionaries';
import { localePath } from '../i18n/utils';
interface Props {
  locale: 'zh' | 'en';
  entry: CollectionEntry<'lab'>;
}
const { locale, entry } = Astro.props;
const ui = getUi(locale);
const { title, summary, basis, status, kind } = entry.data;
const { Content } = await render(entry);
const page = getLabPage(entry.data.translationKey);
const Page = page?.component;
---

<BaseLayout
  locale={locale}
  title={title}
  description={summary}
  bodyClass={page?.descriptor.bodyClass}
  labFonts={page?.descriptor.fonts}
>
  {Page ? (
    <Page locale={locale} entry={entry} />
  ) : (
    <>
      <a href={localePath(locale, '/lab/')}>{ui.lab.back}</a>
      <article>
        <header class="page-heading">
          <p>{kind === 'teardown' ? ui.lab.teardown : ui.lab.simulation}</p>
          <h1>{title}</h1>
          <p>{summary}</p>
        </header>
        <dl class="meta-list">
          <dt>{ui.lab.basis}</dt>
          <dd>{basis}</dd>
          <dt>{ui.lab.status}</dt>
          <dd>{status}</dd>
        </dl>
        <div class="prose">
          <Content />
        </div>
        {kind === 'simulation' && <DemoPanel locale={locale} />}
      </article>
    </>
  )}
</BaseLayout>
