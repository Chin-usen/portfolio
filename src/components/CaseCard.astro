---
import type { CollectionEntry } from 'astro:content';
import { localePath } from '../i18n/utils';
import { getUi } from '../i18n/dictionaries';
interface Props {
  entry: CollectionEntry<'work'>;
  locale: 'zh' | 'en';
  headingLevel?: 'h2' | 'h3';
}
const { entry, locale, headingLevel: Heading = 'h3' } = Astro.props;
const { title, summary, tags, role, period, translationKey } = entry.data;
const ui = getUi(locale);
---

<article class="content-card">
  <Heading>
    <a href={localePath(locale, `/work/${translationKey}/`)}>{title}</a>
  </Heading>
  <p>{summary}</p>
  <p>
    <span>{role}</span> · <span>{period}</span>
  </p>
  <ul class="tag-list" aria-label={ui.work.tools}>
    {tags.map((tag) => (
      <li>{tag}</li>
    ))}
  </ul>
</article>
